 * Pila (LIFO) implementada con nodos enlazados.
 * Solo se accede por el tope: push, pop y peek son O(1).
 */
public class Pila {

    private Nodo tope;
    private int tamano;

    public Pila() {
        tope = null;
        tamano = 0;
    }

    /** Apila una copia del token recibido (así no se alteran los enlaces del original). */
    public void push(Nodo token) {
        Nodo nuevo = new Nodo(token.getValor(), token.getTipo());
        nuevo.setSiguiente(tope);
        tope = nuevo;
        tamano++;
    }

    /** Desapila y devuelve el tope, o null si la pila está vacía. */
    public Nodo pop() {
        if (estaVacia()) {
            return null;
        }
        Nodo sacado = tope;
        tope = tope.getSiguiente();
        sacado.setSiguiente(null);
        tamano--;
        return sacado;
    }

    /** Devuelve el tope sin desapilarlo, o null si la pila está vacía. */
    public Nodo peek() {
        return tope;
    }

    public boolean estaVacia() {
        return tope == null;
    }

    public int getTamano() {
        return tamano;
    }

    public void vaciar() {
        tope = null;
        tamano = 0;
    }

    /** Devuelve el contenido de la pila, del tope hacia la base. */
    public String mostrar() {
        if (estaVacia()) {
            return "[pila vacía]";
        }
        String texto = "TOPE -> ";
        Nodo actual = tope;
        while (actual != null) {
            texto += "[" + actual.getValor() + "]";
            if (actual.getSiguiente() != null) {
                texto += " ";
            }
            actual = actual.getSiguiente();
        }
        return texto + " <- BASE";
    }
}
