    public static Nodo[] tokenizar(String expr) {
        Nodo[] temp = new Nodo[expr.length()];
        int n = 0;
        int i = 0;

        while (i < expr.length()) {
            char c = expr.charAt(i);

            if (c == ' ' || c == '\t') {
                i++;
                continue;
            }

          
            boolean negativoLiteral = c == '-'
                    && i + 1 < expr.length()
                    && (Character.isDigit(expr.charAt(i + 1)) || expr.charAt(i + 1) == '.')
                    && (n == 0
                        || temp[n - 1].getTipo() == Nodo.OPERADOR
                        || temp[n - 1].getTipo() == Nodo.PAREN_ABRE);

            if (Character.isDigit(c) || c == '.' || negativoLiteral) {
                int inicio = i;
                i++;
                while (i < expr.length()
                        && (Character.isDigit(expr.charAt(i)) || expr.charAt(i) == '.')) {
                    i++;
                }
                String literal = expr.substring(inicio, i);
                try {
                    Double.parseDouble(literal);
                } catch (NumberFormatException e) {
                    throw new IllegalArgumentException("Número mal formado: '" + literal + "'.");
                }
                temp[n++] = new Nodo(literal, Nodo.NUMERO);

            } else if (Character.isLetter(c) || c == '_') {
                int inicio = i;
                while (i < expr.length()
                        && (Character.isLetterOrDigit(expr.charAt(i)) || expr.charAt(i) == '_')) {
                    i++;
                }
                temp[n++] = new Nodo(expr.substring(inicio, i), Nodo.VARIABLE);

            } else if (esOperador(c)) {
                temp[n++] = new Nodo(String.valueOf(c), Nodo.OPERADOR);
                i++;

            } else if (c == '(') {
                temp[n++] = new Nodo("(", Nodo.PAREN_ABRE);
                i++;

            } else if (c == ')') {
                temp[n++] = new Nodo(")", Nodo.PAREN_CIERRA);
                i++;

            } else {
                throw new IllegalArgumentException(
                        "Carácter no válido '" + c + "' en la posición " + (i + 1) + ".");
            }
        }

        Nodo[] tokens = new Nodo[n];
        for (int k = 0; k < n; k++) {
            tokens[k] = temp[k];
        }
        return tokens;
    }

    /**
     * Valida paréntesis balanceados (con una pila) y el orden correcto de operandos y operadores.
     * Devuelve null si es válida, o un mensaje con el error encontrado.
     */
    public static String validar(Nodo[] tokens) {
        if (tokens.length == 0) {
            return "La expresión está vacía.";
        }

        Pila parentesis = new Pila();
        boolean esperaOperando = true;

        for (int i = 0; i < tokens.length; i++) {
            Nodo t = tokens[i];
            int pos = i + 1;

            switch (t.getTipo()) {
                case Nodo.NUMERO:
                case Nodo.VARIABLE:
                    if (!esperaOperando) {
                        return "Falta un operador antes de '" + t.getValor() + "' (token " + pos + ").";
                    }
                    esperaOperando = false;
                    break;

                case Nodo.OPERADOR:
                    if (esperaOperando) {
                        return "El operador '" + t.getValor() + "' no tiene operando a su izquierda (token " + pos + ").";
                    }
                    esperaOperando = true;
                    break;

                case Nodo.PAREN_ABRE:
                    if (!esperaOperando) {
                        return "Falta un operador antes de '(' (token " + pos + ").";
                    }
                    parentesis.push(t);
                    break;

                case Nodo.PAREN_CIERRA:
                    if (esperaOperando) {
                        return "Se esperaba un operando antes de ')' (token " + pos + ").";
                    }
                    if (parentesis.estaVacia()) {
                        return "El paréntesis ')' no tiene su '(' correspondiente (token " + pos + ").";
                    }
                    parentesis.pop();
                    break;
            }
        }

        if (!parentesis.estaVacia()) {
            return "Hay " + parentesis.getTamano() + " paréntesis '(' sin cerrar.";
        }
        if (esperaOperando) {
            return "La expresión termina en un operador.";
        }
        return null;
    }

    /**
     * Convierte de notación infija a postfija (algoritmo Shunting-Yard) usando una pila de operadores.
     * Si traza es true, imprime el estado de la pila en cada paso.
     */
    public static Nodo[] aPostfija(Nodo[] tokens, boolean traza) {
        Nodo[] salida = new Nodo[tokens.length];
        int s = 0;
        Pila operadores = new Pila();

        for (int i = 0; i < tokens.length; i++) {
            Nodo t = tokens[i];

            switch (t.getTipo()) {
                case Nodo.NUMERO:
                case Nodo.VARIABLE:
                    salida[s++] = t;
                    break;

                case Nodo.OPERADOR:
                    while (!operadores.estaVacia()
                            && operadores.peek().getTipo() == Nodo.OPERADOR
                            && (precedencia(operadores.peek()) > precedencia(t)
                                || (precedencia(operadores.peek()) == precedencia(t) && !esDerecha(t)))) {
                        salida[s++] = operadores.pop();
                    }
                    operadores.push(t);
                    break;

                case Nodo.PAREN_ABRE:
                    operadores.push(t);
                    break;

                case Nodo.PAREN_CIERRA:
                    while (!operadores.estaVacia() && operadores.peek().getTipo() != Nodo.PAREN_ABRE) {
                        salida[s++] = operadores.pop();
                    }
                    operadores.pop(); // descarta el '('
                    break;
            }

            if (traza) {
                System.out.println("  Token '" + t.getValor() + "'");
                System.out.println("    Pila:   " + operadores.mostrar());
                System.out.println("    Salida: " + unir(salida, s));
            }
        }

        while (!operadores.estaVacia()) {
            salida[s++] = operadores.pop();
            if (traza) {
                System.out.println("  Vaciando pila -> Salida: " + unir(salida, s));
            }
        }

        Nodo[] resultado = new Nodo[s];
        for (int k = 0; k < s; k++) {
            resultado[k] = salida[k];
        }
        return resultado;
    }

    /**
     * Evalúa una expresión en postfija con una pila de operandos.
     * Lanza ArithmeticException o IllegalArgumentException si hay un error.
     */
    public static double evaluar(Nodo[] postfija, String[] nombres, double[] valores, int cantidad) {
        Pila operandos = new Pila();

        for (int i = 0; i < postfija.length; i++) {
            Nodo t = postfija[i];

            if (t.getTipo() == Nodo.NUMERO) {
                operandos.push(t);

            } else if (t.getTipo() == Nodo.VARIABLE) {
                double valor = buscarVariable(t.getValor(), nombres, valores, cantidad);
                operandos.push(new Nodo(String.valueOf(valor), Nodo.NUMERO));

            } else if (t.getTipo() == Nodo.OPERADOR) {
                if (operandos.getTamano() < 2) {
                    throw new IllegalArgumentException("Faltan operandos para '" + t.getValor() + "'.");
                }
                double b = Double.parseDouble(operandos.pop().getValor());
                double a = Double.parseDouble(operandos.pop().getValor());
                double resultado = aplicar(t.getValor().charAt(0), a, b);
                operandos.push(new Nodo(String.valueOf(resultado), Nodo.NUMERO));
            }
        }

        if (operandos.getTamano() != 1) {
            throw new IllegalArgumentException("La expresión no se pudo evaluar correctamente.");
        }
        return Double.parseDouble(operandos.pop().getValor());
    }

    /** Muestra el número sin decimales si es entero. */
    public static String formatear(double d) {
        if (d == Math.rint(d) && Math.abs(d) < 1e15) {
            return String.valueOf((long) d);
        }
        return String.valueOf(d);
    }

    /** Une un arreglo de tokens en una sola línea de texto. */
    public static String unir(Nodo[] tokens, int cantidad) {
        String texto = "";
        for (int i = 0; i < cantidad; i++) {
            texto += tokens[i].getValor();
            if (i < cantidad - 1) {
                texto += " ";
            }
        }
        return texto;
    }

    // ---------- Métodos auxiliares privados ----------

    private static boolean esOperador(char c) {
        return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '^';
    }

    private static int precedencia(Nodo operador) {
        char c = operador.getValor().charAt(0);
        if (c == '^') {
            return 3;
        }
        if (c == '*' || c == '/' || c == '%') {
            return 2;
        }
        return 1;
    }

    private static boolean esDerecha(Nodo operador) {
        return operador.getValor().charAt(0) == '^';
    }

