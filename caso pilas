import java.io.IOException;
import java.io.InputStreamReader;

/**
 * Programa principal: menú interactivo para analizar expresiones aritméticas con una pila.
 */
public class Main {

    private static final int MAX_VARIABLES = 20;

    private static BufferedReader lector = new BufferedReader(new InputStreamReader(System.in));

    // Variables numéricas (arreglos paralelos: nombre y valor)
    private static String[] nombres = new String[MAX_VARIABLES];
    private static double[] valores = new double[MAX_VARIABLES];
    private static int cantidadVariables = 0;

    private static String expresion = "";
    private static Pila pilaManual = new Pila();

    public static void main(String[] args) throws IOException {
        int opcion;
        do {
            menu();
            opcion = leerEntero("Seleccione una opción: ");
            System.out.println();
            ejecutarOpcion(opcion);
        } while (opcion != 0);
    }

    private static void menu() {
        System.out.println("\n==========================================");
        System.out.println("   ANALIZADOR DE EXPRESIONES ARITMÉTICAS  ");
        System.out.println("==========================================");
        System.out.println("Expresión actual: " + (expresion.isEmpty() ? "(ninguna)" : expresion));
        System.out.println("------------------------------------------");
        System.out.println(" 1. Ingresar expresión");
        System.out.println(" 2. Definir o modificar variable");
        System.out.println(" 3. Ver variables");
        System.out.println(" 4. Ver tokens de la expresión");
        System.out.println(" 5. Validar expresión (paréntesis y sintaxis)");
        System.out.println(" 6. Convertir a notación postfija (paso a paso)");
        System.out.println(" 7. Evaluar expresión");
        System.out.println(" 8. Operar la pila manualmente");
        System.out.println(" 0. Salir");
        System.out.println("------------------------------------------");
    }

    private static void ejecutarOpcion(int opcion) throws IOException {
        switch (opcion) {
            case 1: ingresarExpresion(); break;
            case 2: definirVariable(); break;
            case 3: verVariables(); break;
            case 4: verTokens(); break;
            case 5: validarExpresion(); break;
            case 6: convertirPostfija(); break;
            case 7: evaluarExpresion(); break;
            case 8: menuPila(); break;
            case 0: System.out.println("¡Hasta pronto!"); break;
            default: System.out.println("Opción no válida. Intente de nuevo.");
        }
    }

    // ---------- Opciones del menú principal ----------

    private static void ingresarExpresion() throws IOException {
        System.out.println("Operadores: + - * / % ^   |   Paréntesis: ( )");
        System.out.println("Ejemplo: (a + 3) * (b - 2) ^ 2");
        String texto = leerTexto("Digite la expresión: ");
        if (texto.isEmpty()) {
            System.out.println("No se ingresó ninguna expresión.");
        } else {
            expresion = texto;
            System.out.println("Expresión guardada.");
        }
    }

    private static void definirVariable() throws IOException {
        String nombre = leerTexto("Nombre de la variable: ");
        if (!nombreValido(nombre)) {
            System.out.println("Nombre inválido. Debe iniciar con letra o '_' y usar solo letras, números o '_'.");
            return;
        }
        double valor = leerDouble("Valor de " + nombre + ": ");

        for (int i = 0; i < cantidadVariables; i++) {
            if (nombres[i].equals(nombre)) {
                valores[i] = valor;
                System.out.println("Variable actualizada: " + nombre + " = " + Analizador.formatear(valor));
                return;
            }
        }
        if (cantidadVariables == MAX_VARIABLES) {
            System.out.println("Se alcanzó el máximo de " + MAX_VARIABLES + " variables.");
            return;
        }
        nombres[cantidadVariables] = nombre;
        valores[cantidadVariables] = valor;
        cantidadVariables++;
        System.out.println("Variable definida: " + nombre + " = " + Analizador.formatear(valor));
    }

    private static void verVariables() {
        if (cantidadVariables == 0) {
            System.out.println("No hay variables definidas.");
            return;
        }
        System.out.println("Variables definidas:");
        for (int i = 0; i < cantidadVariables; i++) {
            System.out.println("  " + nombres[i] + " = " + Analizador.formatear(valores[i]));
        }
    }

    private static void verTokens() {
        Nodo[] tokens = obtenerTokens();
        if (tokens == null) {
            return;
        }
        System.out.println("Tokens encontrados (" + tokens.length + "):");
        for (int i = 0; i < tokens.length; i++) {
            System.out.println("  " + (i + 1) + ". '" + tokens[i].getValor() + "' -> " + tokens[i].getNombreTipo());
        }
    }

    private static void validarExpresion() {
        Nodo[] tokens = obtenerTokens();
        if (tokens == null) {
            return;
        }
        String error = Analizador.validar(tokens);
        if (error == null) {
            System.out.println("La expresión es VÁLIDA: paréntesis balanceados y sintaxis correcta.");
        } else {
            System.out.println("La expresión es INVÁLIDA: " + error);
        }
    }

    private static void convertirPostfija() {
        Nodo[] tokens = obtenerTokensValidos();
        if (tokens == null) {
            return;
        }
        System.out.println("Conversión de infija a postfija:");
        Nodo[] postfija = Analizador.aPostfija(tokens, true);
        System.out.println("\nNotación postfija: " + Analizador.unir(postfija, postfija.length));
    }

    private static void evaluarExpresion() {
        Nodo[] tokens = obtenerTokensValidos();
        if (tokens == null) {
            return;
        }
        Nodo[] postfija = Analizador.aPostfija(tokens, false);
        try {
            double resultado = Analizador.evaluar(postfija, nombres, valores, cantidadVariables);
            System.out.println("Postfija:  " + Analizador.unir(postfija, postfija.length));
            System.out.println("Resultado: " + Analizador.formatear(resultado));
        } catch (ArithmeticException | IllegalArgumentException e) {
            System.out.println("No se pudo evaluar: " + e.getMessage());
        }
    }

    // ---------- Submenú: operaciones directas sobre la pila ----------

    private static void menuPila() throws IOException {
        int opcion;
        do {
            System.out.println("\n--- OPERACIONES DE LA PILA ---");
            System.out.println("Pila: " + pilaManual.mostrar());
            System.out.println(" 1. Apilar token (push)");
            System.out.println(" 2. Desapilar (pop)");
            System.out.println(" 3. Ver tope (peek)");
            System.out.println(" 4. Ver tamaño");
            System.out.println(" 5. Vaciar pila");
            System.out.println(" 0. Volver al menú principal");
            opcion = leerEntero("Seleccione una opción: ");

            switch (opcion) {
                case 1:
                    String texto = leerTexto("Token a apilar (número, variable, operador o paréntesis): ");
                    try {
                        Nodo[] tokens = Analizador.tokenizar(texto);
                        if (tokens.length != 1) {
                            System.out.println("Debe ingresar exactamente un token.");
                        } else {
                            pilaManual.push(tokens[0]);
                            System.out.println("Apilado: '" + tokens[0].getValor() + "' (" + tokens[0].getNombreTipo() + ")");
                        }
                    } catch (IllegalArgumentException e) {
                        System.out.println("Token inválido: " + e.getMessage());
                    }
                    break;
                case 2:
                    Nodo sacado = pilaManual.pop();
                    if (sacado == null) {
                        System.out.println("La pila está vacía (underflow).");
                    } else {
                        System.out.println("Desapilado: '" + sacado.getValor() + "'");
                    }
                    break;
                case 3:
                    Nodo tope = pilaManual.peek();
                    if (tope == null) {
                        System.out.println("La pila está vacía.");
                    } else {
                        System.out.println("Tope: '" + tope.getValor() + "' (" + tope.getNombreTipo() + ")");
                    }
                    break;
                case 4:
                    System.out.println("Tamaño de la pila: " + pilaManual.getTamano());
                    break;
                case 5:
                    pilaManual.vaciar();
                    System.out.println("Pila vaciada.");
                    break;
                case 0:
                    break;
                default:
                    System.out.println("Opción no válida.");
            }
        } while (opcion != 0);
    }

