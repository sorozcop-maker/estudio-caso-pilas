    /** Tokeniza la expresión actual; devuelve null (y avisa) si no hay expresión o tiene caracteres inválidos. */
    private static Nodo[] obtenerTokens() {
        if (expresion.isEmpty()) {
            System.out.println("Primero ingrese una expresión (opción 1).");
            return null;
        }
        try {
            return Analizador.tokenizar(expresion);
        } catch (IllegalArgumentException e) {
            System.out.println("Error: " + e.getMessage());
            return null;
        }
    }

    /** Tokeniza y valida; devuelve null (y avisa) si la expresión no es válida. */
    private static Nodo[] obtenerTokensValidos() {
        Nodo[] tokens = obtenerTokens();
        if (tokens == null) {
            return null;
        }
        String error = Analizador.validar(tokens);
        if (error != null) {
            System.out.println("La expresión es inválida: " + error);
            return null;
        }
        return tokens;
    }

    private static boolean nombreValido(String nombre) {
        if (nombre.isEmpty()) {
            return false;
        }
        char primero = nombre.charAt(0);
        if (!Character.isLetter(primero) && primero != '_') {
            return false;
        }
        for (int i = 1; i < nombre.length(); i++) {
            char c = nombre.charAt(i);
            if (!Character.isLetterOrDigit(c) && c != '_') {
                return false;
            }
        }
        return true;
    }

    private static String leerTexto(String mensaje) throws IOException {
        System.out.print(mensaje);
        String linea = lector.readLine();
        return linea == null ? "" : linea.trim();
    }

    private static int leerEntero(String mensaje) throws IOException {
        while (true) {
            try {
                return Integer.parseInt(leerTexto(mensaje));
            } catch (NumberFormatException e) {
                System.out.println("Ingrese un número entero válido.");
            }
        }
    }

    private static double leerDouble(String mensaje) throws IOException {
        while (true) {
            try {
                return Double.parseDouble(leerTexto(mensaje));
            } catch (NumberFormatException e) {
                System.out.println("Ingrese un número válido.");
            }
        }
    }
